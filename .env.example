# Copy to `.env` (git-ignored) and fill in. PLACEHOLDERS ONLY: never commit real values.
# Paths are relative to the backend/ directory; run every command from there.

APP_ENV=development
LOG_LEVEL=INFO
# Disable /docs, /redoc and /openapi.json when exposed through a public tunnel
API_DOCS_ENABLED=true

# --- Database -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/autopay_recovery.db
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL=true
WORKBOOK_PATH=../synthetic-data/data/autopay_recovery_customers.xlsx

# --- Operator API (required for every /api/v1 route except health and Twilio webhooks) -----
OPERATOR_API_KEY=replace-with-a-long-random-string

# --- Fireworks AI (GLM) -----------------------------------------------------------------------
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=1

# --- Natural-language read-only SQL endpoint (development/test only) ----------------------
SQL_QUERY_ENABLED=false
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=5

# --- Simulation ---------------------------------------------------------------------------
SIMULATION_DEFAULT_TIMEZONE=Asia/Kolkata
SIMULATION_INITIAL_TIME=2026-10-01T00:00:00+05:30
SIMULATION_DEV_ENDPOINTS_ENABLED=true

# --- Recovery calls (manual approval is ALWAYS required) -----------------------------------
# Comma-separated E.164 numbers YOU control (e.g. your own verified phone). Every other number
# is refused, and numbers belonging to customer records are refused even if listed here.
TWILIO_ALLOWED_TEST_NUMBERS=+910000000000
# Synthetic seed records carry no real consent. Set true ONLY to call an allowlisted
# tester-controlled number for a demo.
ALLOW_SYNTHETIC_CONSENT_FOR_TEST_DESTINATIONS=false

# --- Twilio -----------------------------------------------------------------------------------
# Live calls need BOTH TELEPHONY_PROVIDER=twilio AND TWILIO_ENABLED=true (double opt-in).
TELEPHONY_PROVIDER=mock
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+10000000000
# Public HTTPS base URL that reaches this app (e.g. your ngrok URL). Webhook URLs and
# signature validation are built from it; it must match exactly what Twilio calls.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
TELEPHONY_TIMEOUT_SECONDS=10
TELEPHONY_RECONCILE_GRACE_SECONDS=120
# true for Twilio trial accounts: omits timeout/time_limit, which trials reject
TWILIO_TRIAL_ACCOUNT=false
# Trial sandbox number sends unsigned webhooks; accept them ONLY with a strict session + CallSid
# match (development/test, trial, live). Weaker than signature validation. Keep false otherwise.
TWILIO_TRIAL_ACCEPT_UNSIGNED_WEBHOOKS=false
# Local curl testing only: accept unsigned webhooks when no auth token is set and Twilio is off.
TWILIO_ALLOW_UNSIGNED_WEBHOOKS=false

# --- Voice conversation -------------------------------------------------------------------------
VOICE_COMPANY_NAME=the subscription service
VOICE_AGENT_NAME=Alex
TWILIO_SPEECH_LOCALE=en-IN
# Live test 2026-10-14: experimental_conversations returned empty results for short answers
# ("yes"); experimental_utterances (tuned for short utterances) recognised them.
TWILIO_SPEECH_MODEL=experimental_conversations
TWILIO_SPEECH_TIMEOUT_SECONDS=2
TWILIO_GATHER_TIMEOUT_SECONDS=5
TWILIO_TTS_VOICE=Polly.Raveena
VOICE_MAX_TURNS=12
VOICE_MAX_SILENCE_PROMPTS=2
VOICE_MAX_UNCLEAR=1
VOICE_MAX_CALL_SECONDS=300
VOICE_LLM_TIMEOUT_SECONDS=8
# After this, the webhook answers with a 1 s hold + redirect and the redirect gets the reply.
VOICE_WEBHOOK_REPLY_WITHIN_SECONDS=3
VOICE_LLM_MAX_TOKENS=1200

# --- Transcripts (text only; audio recording is not enabled) ---------------------------------
# store_sanitized: redacted text kept after the transcript notice; metadata_only: no customer text
TRANSCRIPT_POLICY=store_sanitized
TRANSCRIPT_STORE_ORIGINAL=false
TRANSCRIPT_RETENTION_DAYS=30
